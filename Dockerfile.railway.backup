# Use official Node.js image
FROM node:22-alpine

# Install yt-dlp, ffmpeg, and python3
RUN apk add --no-cache \
    python3 \
    py3-pip \
    ffmpeg \
    && pip3 install --break-system-packages yt-dlp

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --omit=dev

# Copy application code
COPY . .

# Build Next.js
RUN npm run build

# Expose port
EXPOSE 20127

# Start application
CMD ["npm", "start"]
